# NWClient unified Java/Gradle workspace (IntelliJ IDEA)
# Generated build files in the workspace root (child Git submodules own theirs).
/.gradle/
/build/
/logs/
/out/
/target/
/.kotlin/

# The unified workspace uses Cosmetic's Gradle wrapper. IntelliJ or Gradle
# may generate wrapper scripts in the root; these are not source files.
/gradle/
/gradlew
/gradlew.bat

# IntelliJ IDEA local project metadata and user settings.
/.idea/
*.iml
*.iws
*.ipr

# Shared IntelliJ Run/Debug configurations in .run/ are tracked by Git.
# Do not ignore .run/ — it contains the team's Minecraft debug profiles.

# Python helper script caches, local environments and test artifacts.
__pycache__/
*.py[cod]
/.pytest_cache/
/.venv/

# Local deployment, environment values, and generated launch scripts.
/deploy.toml
/.env
/.env.*
!/.env.example
/launch_nwclient.cmd
/launch_nwclient.sh

# JVM crashes and local logs.
*.class
*.log
*.hprof
hs_err_pid*
replay_pid*

# Platform/editor leftovers.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
